# Cabeceras para Netlify
# Los dos hashes sha256 de la CSP permiten solo el script y el estilo en linea de la
# insignia que Netlify inyecta en el plan gratuito; el resto de la CSP es estricta.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BkKP2XO6WOEc3kXOiLr2ZoY83hamalKjPY9xBcbXVuw='; style-src 'self' 'sha256-hhwpibRbnK51W94YgCl+Ayz2oMVrU1tcQHsbO9KWPYM=' 'sha256-YWf6m3ddoYwyUYLF1LCiVDDGBIw2nxqs2Tji6+hfgLc=' 'sha256-3y5TlF5zG6/2W5bLJcFMMnGWSDYZMPAJMXGh07elcnY='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://raw.githubusercontent.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Fuentes: nombres estables, cache larga
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000

# CSS y JS sin hash en el nombre: revalidar para que los cambios lleguen
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/privacidad/
  Cache-Control: public, max-age=0, must-revalidate

/guia/*
  Cache-Control: public, max-age=0, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
